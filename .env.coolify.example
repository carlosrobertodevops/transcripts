# =============================================================================
# .env.coolify.example — TEMPLATE para o painel "Environment Variables" do
# Coolify v4. Este é o ÚNICO arquivo versionado relacionado a deploy Coolify.
# =============================================================================
# Cole o conteúdo deste arquivo na UI do Coolify (Environment Variables) e
# preencha os valores DIRETAMENTE no painel. Nunca preencha valores reais aqui
# no repositório. docker-compose-coolify.yml referencia cada variável via
# ${VAR} / ${VAR:-default} e o Coolify injeta em runtime.
#
# Convenções:
#   - Variáveis SERVICE_* são geradas automaticamente pelo Coolify na primeira
#     deploy. Deixe vazias na UI; o Coolify popula e reusa entre restarts.
#   - Chaves de terceiros (GROQ_API_KEY, OPENAI_API_KEY) entram só na UI,
#     nunca no repo.
#   - JWT_SECRET / JWT_REFRESH_SECRET / INTERNAL_API_KEY usam Coolify
#     "Magic" base64 (64 bytes) — autogerados.
#
# Para teste local com Coolify: copie este arquivo para .env.coolify (já
# ignorado pelo git), preencha os valores e rode docker compose
# -f docker-compose-coolify.yml up.
# =============================================================================

# --- Coolify magic FQDN / rede ---
SERVICE_FQDN_APP=
SERVICE_FQDN_APP_3000=

# --- Postgres (Coolify autogera SERVICE_PASSWORD_POSTGRES) ---
SERVICE_USER_POSTGRES=transcripts
SERVICE_PASSWORD_POSTGRES=
POSTGRES_DB=transcripts

# --- App / Auth (Coolify autogera SERVICE_BASE64_64_*) ---
NODE_ENV=production
SERVICE_BASE64_64_JWT=
SERVICE_BASE64_64_REFRESH=
SERVICE_BASE64_64_INTERNAL=

# --- Transcription provider ---
# Valores aceitos: local | groq | openai
TRANSCRIPTION_PROVIDER=local
TRANSCRIPTION_PROVIDER_FALLBACK=
TRANSCRIBER_TIMEOUT_MS=60000

# --- Chaves de terceiros (preencher SOMENTE no painel Coolify) ---
# Obtenha em https://console.groq.com/keys e https://platform.openai.com/api-keys
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Whisper local (faster-whisper) ---
WHISPER_MODEL=tiny
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# --- Worker ---
WORKER_INTERVAL_MS=3000

# --- Logging ---
LOG_LEVEL=INFO

# --- pgAdmin (opcional, só se incluir o serviço no compose) ---
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
